# ── Plaid ──
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here

# ── Booking / Google Calendar ──
# Full walkthrough in BOOKING_SETUP.md. Without these three the booking page
# loads but politely says it is not connected yet.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Any random string you pick. Unlocks the one time browser setup at
# /api/booking/oauth/start?key=<this value>. Setup closes itself automatically
# once GOOGLE_REFRESH_TOKEN below is filled in.
BOOKING_SETUP_KEY=

# Left blank until setup. Produced by the browser flow above, or locally by
# running: node scripts/google-auth.js
GOOGLE_REFRESH_TOKEN=

PORT=3000
