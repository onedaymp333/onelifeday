# OneDay Books environment settings.
# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
#
# You get these two from your Supabase project:
#   Supabase dashboard  ->  Project Settings  ->  API
# These two are safe to expose to the browser by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key is a master key. It stays on the server only.
# Never put it in a NEXT_PUBLIC_ variable and never commit it.
# Used later by server side jobs (backups, scheduled syncs).
SUPABASE_SERVICE_ROLE_KEY=

# The AI switch. Leave blank to keep Claude help OFF (free).
# When you are ready, paste your Anthropic key here to turn it on.
ANTHROPIC_API_KEY=
AI_ENABLED=false
